{
  "name": "aliyas-real-estate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=11.16.0"
  },
  "workspaces": [
    "apps/public-web",
    "apps/admin-web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:public": "npm run dev --workspace=@are/public-web",
    "dev:admin": "npm run dev --workspace=@are/admin-web",
    "dev:mobile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-port.ps1 -Port 50018 && npm run dev --workspace=@are/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
