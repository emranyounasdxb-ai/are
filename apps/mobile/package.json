{
  "name": "@are/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first ../../node_modules/expo/bin/cli start --dev-client --localhost --port 50018",
    "android": "node --dns-result-order=ipv4first ../../node_modules/expo/bin/cli start --dev-client --localhost --port 50018 --android",
    "ios": "node --dns-result-order=ipv4first ../../node_modules/expo/bin/cli start --dev-client --localhost --port 50018 --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "install": {
      "exclude": ["react"]
    }
  },
  "dependencies": {
    "expo": "57.0.15",
    "expo-constants": "57.0.13",
    "expo-dev-client": "57.0.14",
    "expo-linking": "57.0.7",
    "expo-router": "57.0.15",
    "expo-status-bar": "57.0.1",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "typescript": "6.0.3"
  }
}
