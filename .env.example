# Copy to .env and provide local-only values. Never commit the populated file.
ARE_POSTGRES_USER=are_local
ARE_POSTGRES_PASSWORD=
ARE_POSTGRES_DB=are_local
ARE_DATABASE_URL=
ARE_REDIS_URL=redis://redis:6379/0
ARE_ENVIRONMENT=local
ARE_SESSION_COOKIE_SECURE=false
NEXT_PUBLIC_ARE_ADMIN_URL=http://127.0.0.1:50002
NEXT_PUBLIC_ARE_API_URL=http://127.0.0.1:50003/api/v1
ARE_CORS_ORIGINS=http://127.0.0.1:50001,http://127.0.0.1:50002
# Optional owner-approved Overview provider configuration. Leave all four unset otherwise.
ARE_OVERVIEW_AI_PROVIDER=
ARE_OVERVIEW_AI_MODEL=
ARE_OVERVIEW_AI_MODEL_VERSION=
ARE_OVERVIEW_AI_API_KEY=
